# انسخ هذا الملف باسم .env على استضافة الموقع واملأ القيم

# رابط الـ API الداخلي لجهة البوت (لازم يكون مكشوف من النت)
# مثال: https://your-bot-host.example.com:4000  أو  http://1.2.3.4:4000
BOT_API_URL=https://ضع_رابط_وبورت_جهة_البوت_هنا

# نفس المفتاح السري بالضبط اللي حطيته بجهة البوت (BOT_API_KEY)
BOT_API_KEY=اختر_نص_سري_عشوائي_طويل_وضعه_بالجهتين

# منفذ موقع الداش بورد (بعض الاستضافات تفرض المتغير PORT تلقائياً، تجاهل هذا حينها)
DASHBOARD_PORT=3000

# مفتاح تشفير الجلسات
DASHBOARD_SESSION_SECRET=غير_هذا_النص_لشي_عشوائي_طويل

# حساب الأدمن الافتراضي لأول تشغيل فقط
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASS=غير_هذي_كلمة_المرور
